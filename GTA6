<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GTA 6 • Leonida Rehberi | RynexDEV</title>
    <meta name="description" content="GTA 6 Leonida Rehberi - Hileler, Harita, Bilinmeyen Yerler, Sürümler. RynexDEV tarafından hazırlandı.">
    <style>
        /* === GENEL AYARLAR === */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', 'Poppins', system-ui, sans-serif;
        }

        body {
            background: #0a0a0f;
            color: #f0f0f0;
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* === NEON GRADYAN & IŞIK EFEKTLERİ === */
        .neon-text {
            background: linear-gradient(135deg, #ff2d95, #00e5ff, #ffb800);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 30px rgba(255, 45, 149, 0.3);
        }

        .glow {
            box-shadow: 0 0 20px rgba(255, 45, 149, 0.2), 0 0 60px rgba(0, 229, 255, 0.1);
        }

        /* === SCROLLBAR === */
        ::-webkit-scrollbar {
            width: 10px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0a0f;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #ff2d95, #00e5ff);
            border-radius: 10px;
        }

        /* === HERO / BAŞLIK === */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 2rem;
            background: radial-gradient(ellipse at 50% 30%, #1a0a2e 0%, #0a0a0f 70%);
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url('https://images.unsplash.com/photo-1519501025264-65ba15a82390?w=1600&q=80');
            background-size: cover;
            background-position: center;
            opacity: 0.08;
            filter: blur(4px);
            z-index: 0;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 900px;
        }

        .hero h1 {
            font-size: clamp(3rem, 12vw, 8rem);
            font-weight: 900;
            letter-spacing: 0.05em;
            line-height: 1;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            animation: fadeUp 1s ease-out;
        }

        .hero .subtitle {
            font-size: clamp(1rem, 3vw, 1.8rem);
            font-weight: 300;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: #a0a0b0;
            margin-bottom: 2rem;
            animation: fadeUp 1.2s ease-out;
        }

        .badge {
            display: inline-block;
            background: linear-gradient(135deg, #ff2d95, #cc0077);
            padding: 0.6rem 2rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            animation: pulse 2s infinite;
            margin-bottom: 1.5rem;
        }

        .creator-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(0, 229, 255, 0.1);
            border: 1px solid rgba(0, 229, 255, 0.3);
            padding: 0.4rem 1.2rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #00e5ff;
            margin-top: 2rem;
            animation: fadeUp 1.5s ease-out;
        }

        .creator-badge span {
            width: 8px;
            height: 8px;
            background: #00e5ff;
            border-radius: 50%;
            box-shadow: 0 0 10px #00e5ff;
            animation: blink 1.5s infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); box-shadow: 0 0 20px rgba(255, 45, 149, 0.4); }
            50% { transform: scale(1.05); box-shadow: 0 0 40px rgba(255, 45, 149, 0.8); }
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .scroll-hint {
            position: absolute;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%);
            color: #666;
            font-size: 0.85rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(10px); }
        }

        /* === NAVİGASYON === */
        .navbar {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(10, 10, 15, 0.85);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 45, 149, 0.2);
            padding: 0.8rem 2rem;
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .navbar a {
            color: #ccc;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            transition: all 0.3s;
        }

        .navbar a:hover {
            color: #fff;
            background: rgba(255, 45, 149, 0.15);
            box-shadow: 0 0 15px rgba(255, 45, 149, 0.2);
        }

        /* === BÖLÜM BAŞLIKLARI === */
        .section {
            padding: 5rem 2rem;
            max-width: 1300px;
            margin: 0 auto;
        }

        .section-title {
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 900;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }

        .section-sub {
            color: #888;
            font-size: 1.1rem;
            margin-bottom: 3rem;
            max-width: 700px;
        }

        /* === KARTLAR === */
        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .card {
            background: linear-gradient(145deg, #12121a, #1a1a28);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
        }

        .card:hover {
            transform: translateY(-8px);
            border-color: rgba(255, 45, 149, 0.4);
            box-shadow: 0 20px 60px rgba(255, 45, 149, 0.15);
        }

        .card-img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            display: block;
            filter: brightness(0.9);
            transition: filter 0.4s;
        }

        .card:hover .card-img {
            filter: brightness(1.1);
        }

        .card-body {
            padding: 1.5rem;
        }

        .card-body h3 {
            font-size: 1.3rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            color: #fff;
        }

        .card-body p {
            color: #999;
            font-size: 0.95rem;
        }

        /* === HİLE KODLARI === */
        .cheat-tabs {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }

        .cheat-tab {
            background: #1a1a28;
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #aaa;
            padding: 0.6rem 1.4rem;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.3s;
        }

        .cheat-tab.active, .cheat-tab:hover {
            background: linear-gradient(135deg, #ff2d95, #cc0077);
            color: #fff;
            border-color: transparent;
        }

        .cheat-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
            display: none;
        }

        .cheat-table.active {
            display: table;
        }

        .cheat-table th {
            text-align: left;
            padding: 0.8rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #666;
            font-weight: 700;
        }

        .cheat-table td {
            background: #12121a;
            padding: 1rem;
            font-size: 0.9rem;
        }

        .cheat-table tr td:first-child {
            border-radius: 12px 0 0 12px;
            font-weight: 700;
            color: #eee;
        }

        .cheat-table tr td:last-child {
            border-radius: 0 12px 12px 0;
            font-family: 'Courier New', monospace;
            color: #00e5ff;
            letter-spacing: 0.15em;
            font-weight: 700;
        }

        .cheat-table tr:hover td {
            background: #1a1a28;
        }

        /* === HARİTA === */
        .map-container {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .map-container img {
            width: 100%;
            display: block;
            filter: saturate(1.2) contrast(1.05);
        }

        .map-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(10, 10, 15, 0.95) 0%, transparent 50%);
            pointer-events: none;
        }

        .map-labels {
            position: absolute;
            bottom: 2rem;
            left: 2rem;
            right: 2rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .map-tag {
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            padding: 0.4rem 1rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            border: 1px solid rgba(255, 45, 149, 0.3);
            color: #fff;
        }

        /* === BİLİNMEYEN YERLER === */
        .mystery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .mystery-card {
            background: linear-gradient(135deg, #1a0a2e 0%, #12121a 100%);
            border: 1px solid rgba(255, 45, 149, 0.2);
            border-radius: 16px;
            padding: 1.8rem;
            position: relative;
            overflow: hidden;
            transition: all 0.3s;
        }

        .mystery-card::before {
            content: '?';
            position: absolute;
            top: -10px;
            right: 10px;
            font-size: 6rem;
            font-weight: 900;
            color: rgba(255, 45, 149, 0.06);
            pointer-events: none;
        }

        .mystery-card:hover {
            border-color: rgba(255, 45, 149, 0.6);
            box-shadow: 0 0 30px rgba(255, 45, 149, 0.15);
        }

        .mystery-card h4 {
            font-size: 1.1rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            color: #ff2d95;
        }

        .mystery-card p {
            color: #999;
            font-size: 0.9rem;
        }

        /* === SÜRÜMLER === */
        .edition-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .edition-card {
            background: linear-gradient(145deg, #12121a, #1a1a28);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 24px;
            padding: 2.5rem;
            text-align: center;
            position: relative;
            transition: all 0.4s;
        }

        .edition-card.featured {
            border-color: #ff2d95;
            box-shadow: 0 0 40px rgba(255, 45, 149, 0.2);
        }

        .edition-card.featured::before {
            content: 'EN POPÜLER';
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #ff2d95, #cc0077);
            padding: 0.3rem 1.5rem;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.1em;
        }

        .edition-card h3 {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
        }

        .edition-card .price {
            font-size: 3rem;
            font-weight: 900;
            margin: 1rem 0;
            background: linear-gradient(135deg, #ff2d95, #00e5ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .edition-card ul {
            list-style: none;
            text-align: left;
            margin: 1.5rem 0;
        }

        .edition-card li {
            padding: 0.4rem 0;
            color: #aaa;
            font-size: 0.9rem;
        }

        .edition-card li::before {
            content: '✓';
            color: #00e5ff;
            font-weight: 700;
            margin-right: 0.5rem;
        }

        /* === GALERİ === */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }

        .gallery-grid img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 12px;
            transition: all 0.4s;
            filter: brightness(0.8) saturate(1.1);
            cursor: pointer;
        }

        .gallery-grid img:hover {
            transform: scale(1.03);
            filter: brightness(1.1) saturate(1.3);
            box-shadow: 0 10px 40px rgba(255, 45, 149, 0.3);
        }

        /* === YAPIMCI / CREATOR BÖLÜMÜ === */
        .creator-section {
            padding: 5rem 2rem;
            max-width: 1100px;
            margin: 0 auto;
        }

        .creator-card {
            position: relative;
            background: linear-gradient(135deg, #1a0a2e 0%, #12121a 50%, #0a1a2a 100%);
            border: 1px solid rgba(255, 45, 149, 0.3);
            border-radius: 32px;
            padding: 3rem;
            overflow: hidden;
            text-align: center;
            box-shadow: 0 0 80px rgba(255, 45, 149, 0.1), inset 0 0 60px rgba(0, 229, 255, 0.03);
        }

        .creator-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, transparent, rgba(255, 45, 149, 0.15), transparent, rgba(0, 229, 255, 0.15), transparent);
            animation: rotate 8s linear infinite;
            z-index: 0;
        }

        .creator-card::after {
            content: '';
            position: absolute;
            inset: 2px;
            background: linear-gradient(135deg, #1a0a2e 0%, #12121a 50%, #0a1a2a 100%);
            border-radius: 30px;
            z-index: 0;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .creator-content {
            position: relative;
            z-index: 2;
        }

        .creator-avatar {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            margin: 0 auto 1.5rem;
            background: linear-gradient(135deg, #ff2d95, #00e5ff);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: 900;
            color: #0a0a0f;
            box-shadow: 0 0 40px rgba(255, 45, 149, 0.5), 0 0 80px rgba(0, 229, 255, 0.2);
            letter-spacing: -2px;
            animation: avatarFloat 3s ease-in-out infinite;
        }

        @keyframes avatarFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        .creator-card h2 {
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 900;
            letter-spacing: 0.02em;
            margin-bottom: 0.3rem;
            text-transform: uppercase;
        }

        .creator-role {
            color: #00e5ff;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            margin-bottom: 1.5rem;
        }

        .creator-bio {
            color: #bbb;
            max-width: 650px;
            margin: 0 auto 2.5rem;
            font-size: 1.05rem;
            line-height: 1.8;
        }

        .creator-bio strong {
            color: #fff;
            font-weight: 700;
        }

        .contact-grid {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }

        .contact-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;
            padding: 0.9rem 1.8rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            letter-spacing: 0.03em;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 1px solid transparent;
        }

        .contact-btn svg {
            width: 20px;
            height: 20px;
        }

        .contact-btn.instagram {
            background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
            color: #fff;
        }

        .contact-btn.instagram:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 15px 40px rgba(253, 29, 29, 0.4);
        }

        .contact-btn.email {
            background: linear-gradient(135deg, #00e5ff, #0077ff);
            color: #fff;
        }

        .contact-btn.email:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 15px 40px rgba(0, 119, 255, 0.4);
        }

        .contact-btn.github {
            background: #1a1a28;
            color: #fff;
            border-color: rgba(255, 255, 255, 0.15);
        }

        .contact-btn.github:hover {
            transform: translateY(-4px) scale(1.03);
            border-color: #00e5ff;
            box-shadow: 0 15px 40px rgba(0, 229, 255, 0.2);
        }

        .tech-stack {
            display: flex;
            gap: 0.6rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 1.5rem;
        }

        .tech-pill {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #aaa;
            padding: 0.4rem 1rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .tech-pill:hover {
            color: #fff;
            border-color: rgba(255, 45, 149, 0.5);
        }

        /* === FOOTER === */
        footer {
            text-align: center;
            padding: 3rem 2rem 2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            color: #555;
            font-size: 0.85rem;
            background: linear-gradient(to top, rgba(255, 45, 149, 0.03), transparent);
        }

        .footer-brand {
            font-size: 1.3rem;
            font-weight: 900;
            letter-spacing: 0.1em;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
        }

        .footer-info {
            color: #777;
            margin: 0.3rem 0;
        }

        .footer-links {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            margin: 1.5rem 0;
            flex-wrap: wrap;
        }

        .footer-links a {
            color: #999;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            transition: color 0.3s;
        }

        .footer-links a:hover {
            color: #ff2d95;
        }

        .footer-signature {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 1.5rem;
            padding: 0.6rem 1.5rem;
            background: rgba(255, 45, 149, 0.08);
            border: 1px solid rgba(255, 45, 149, 0.2);
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #ff2d95;
        }

        .heart {
            color: #ff2d95;
            animation: heartbeat 1.5s ease-in-out infinite;
            display: inline-block;
        }

        @keyframes heartbeat {
            0%, 100% { transform: scale(1); }
            25% { transform: scale(1.2); }
            50% { transform: scale(1); }
            75% { transform: scale(1.15); }
        }

        /* === FLOATING BADGE === */
        .floating-credit {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 999;
            background: rgba(10, 10, 15, 0.9);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 45, 149, 0.4);
            border-radius: 50px;
            padding: 0.6rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #fff;
            text-decoration: none;
            box-shadow: 0 10px 30px rgba(255, 45, 149, 0.25);
            transition: all 0.3s;
        }

        .floating-credit:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 45px rgba(255, 45, 149, 0.4);
        }

        .floating-credit .dot {
            width: 8px;
            height: 8px;
            background: #00e5ff;
            border-radius: 50%;
            box-shadow: 0 0 10px #00e5ff;
            animation: blink 1.5s infinite;
        }

        .floating-credit .brand {
            background: linear-gradient(135deg, #ff2d95, #00e5ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }

        /* === RESPONSIVE === */
        @media (max-width: 768px) {
            .navbar {
                gap: 0.2rem;
                padding: 0.6rem 0.5rem;
            }
            .navbar a {
                font-size: 0.7rem;
                padding: 0.4rem 0.6rem;
            }
            .section {
                padding: 3rem 1rem;
            }
            .cheat-table td, .cheat-table th {
                padding: 0.6rem;
                font-size: 0.8rem;
            }
            .cheat-table tr td:last-child {
                font-size: 0.75rem;
                letter-spacing: 0.05em;
            }
            .creator-card {
                padding: 2rem 1.2rem;
            }
            .creator-avatar {
                width: 90px;
                height: 90px;
                font-size: 2rem;
            }
            .contact-btn {
                font-size: 0.85rem;
                padding: 0.8rem 1.4rem;
            }
            .floating-credit {
                font-size: 0.65rem;
                padding: 0.5rem 1rem;
                bottom: 12px;
                right: 12px;
