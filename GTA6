    <script>
        function showCheat(tab, btn) {
            // Hide all tables
            document.querySelectorAll('.cheat-table').forEach(t => t.classList.remove('active'));
            // Remove active class from all tabs
            document.querySelectorAll('.cheat-tab').forEach(b => b.classList.remove('active'));
            // Show selected table
            document.getElementById('tab-' + tab).classList.add('active');
            // Activate clicked button
            btn.classList.add('active');
        }

        // Smooth scroll for nav links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Add subtle animation on scroll
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.card, .mystery-card, .edition-card, .creator-card').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(30px)';
            el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(el);
        });
    </script>
